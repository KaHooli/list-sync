# ╔══════════════════════════════════════════════════════════════════════════════╗
#   ListSync - Core-Only Configuration
#   Minimal deployment with ONLY sync functionality (no UI, no API)
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
#  QUICK START:
#  1. Copy this file to '.env'
#  2. Configure the REQUIRED fields
#  3. Customize your content lists
#  4. Run: docker-compose up listsync-core
#

# 🔌 Seerr Connection ──────────────────────────────────────────────────────────────
# Seerr is what Overseerr and Jellyseerr became: https://seerr.dev
# The old OVERSEERR_* names still work, so an existing .env needs no edits.
# API Key from Settings → General → API Key
SEERR_API_KEY=your_seerr_api_key_here
SEERR_URL=https://your-seerr-url.com/
SEERR_USER_ID=1
SEERR_4K=false

# 🎯 ID resolution - set at least ONE of these ──────────────────────────────────────
# Lists give IMDb IDs; Overseerr is addressed by TMDB ID, so something has to
# bridge the two. Without either key below, matching falls back to fuzzy title
# search, which mismatches remakes, sequels and titles that share a name.
#
# TMDB_KEY (recommended) is free and resolves IMDb IDs in one hop. It lives in
# the Content Sources section below, since it also serves TMDB lists.
#   https://www.themoviedb.org/settings/api
#
# TRAKT_CLIENT_ID also works, but registering a Trakt API application now
# requires a paid Trakt VIP subscription. Use the Client ID, not the Secret.
#   https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=

# ⚙️  System Settings ───────────────────────────────────────────────────────────────
TZ=Europe/London                                        # America/New_York, Europe/London, etc.
AUTOMATED_MODE=true                                     # true | false
SYNC_INTERVAL=24                                        # Hours between syncs (minimum: 1)
DISCORD_WEBHOOK_URL=                                    # Leave blank to disable

# 📺 Content Sources ────────────────────────────────────────────────────────────────
#
# Per-list Overseerr user:
#   Any list below can request as a specific Overseerr user by appending '::<user id>'
#   to the entry. Lists without one request as SEERR_USER_ID above.
#     IMDB_LISTS=ls026785255::5,ls098765432::7,top
#   Find the user IDs in Overseerr under Settings → Users. Each user needs the
#   "Request" permission and enough request quota, otherwise Overseerr rejects
#   their requests.

# ── IMDb Lists ──
# Formats: 'top', 'popular', or list IDs like 'ls026785255'
IMDB_LISTS=

# ── Trakt Lists ──
# Format: https://app.trakt.tv/users/{user}/lists/{name}
TRAKT_LISTS=

# ── Trakt Special Lists ──
# Format: type:category (e.g., trending:movies, popular:shows)
TRAKT_SPECIAL_LISTS=
TRAKT_SPECIAL_ITEMS_LIMIT=20

# ── Letterboxd Lists ──
# Format: username/list-slug
LETTERBOXD_LISTS=

# ── MDBList Collections ──
# Format: username/list-name
MDBLIST_LISTS=

# ── Steven Lu Lists ──
# Options: 'stevenlu'
STEVENLU_LISTS=

# ── TMDB Lists ──
TMDB_KEY=
# Format: https://www.themoviedb.org/list/{id-name}
TMDB_LISTS=

# ── TVDB Lists ──
# Format: https://www.thetvdb.com/lists/{id or name}
TVDB_LISTS=

# ── SIMKL Lists ──
# Format: https://simkl.com/{id}/list/{id}/{name}
SIMKL_LISTS=

# ── AniList Anime Lists ── 
# Format: https://anilist.co/user/{username}/animelist or just {username}
# For specific status: https://anilist.co/user/{username}/animelist/Planning
# Supported statuses: Planning, Watching, Completed, Paused, Dropped
ANILIST_LISTS=

# ╔══════════════════════════════════════════════════════════════════════════════╗
#   ⚠️  CORE-ONLY MODE
#   • No web UI available
#   • No API server 
#   • Only sync functionality
#
#   💡 Title Matching Workflow:
#   1. Direct TMDB ID lookup (fastest, most accurate)
#   2. IMDB ID → Trakt API → TMDB ID (requires TRAKT_CLIENT_ID)
#   3. Title/Year → Trakt API → TMDB ID (requires TRAKT_CLIENT_ID)
#   4. Fallback to text search (less reliable)
# ╚══════════════════════════════════════════════════════════════════════════════╝